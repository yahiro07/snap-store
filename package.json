{
  "name": "snap-store",
  "version": "0.1.13",
  "description": "An easy-to-use global state management library for React.",
  "author": "yahiro",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "import": "./dist/preact/index.js",
      "require": "./dist/preact/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahiro07/snap-store.git"
  },
  "bugs": {
    "url": "https://github.com/yahiro07/snap-store/issues"
  },
  "homepage": "https://github.com/yahiro07/snap-store#readme",
  "keywords": [
    "react",
    "state",
    "management",
    "store",
    "signal",
    "reactive",
    "hooks"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "preact": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "preact": "^10.0.0",
    "limu": "^4.1.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
